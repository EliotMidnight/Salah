<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (Android 12+ cloud backup and device transfer).
     Backed up: app preferences (calculation method, alerts, location,
     reading progress, bookmarks database). Nothing sensitive is stored:
     no accounts, tokens, passwords, or credentials. Location stays
     on-device except for this standard OS-level backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
