<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules (Android 12 and below, plus legacy full backup).
     The app stores only on-device preferences (prayer settings, location,
     reading progress) and a small Room database (prayer log, bookmarks).
     No accounts, tokens, or credentials exist, so everything here is safe
     to back up and restore. See res/xml/data_extraction_rules.xml for
     Android 12+ rules. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <include domain="file" path="." />
</full-backup-content>
